# PoshPulse Environment Variables
# Copy this to .env and fill in your values.
# Never commit .env to git.

# ── Poshmark credentials ──────────────────────────────────────────────────────
POSHMARK_USERNAME=
POSHMARK_PASSWORD=

# ── Notification email (where to send digests and alerts) ────────────────────
NOTIFY_EMAIL=rdsioson@gmail.com

# ── Timing config (milliseconds) ─────────────────────────────────────────────
RELIST_INTERVAL_MS=90000          # 90 seconds between each relist action
SHARE_INTERVAL_MS=95000           # 95 seconds between each share click
SHARE_CYCLE_MS=3600000            # 60 minutes between full share cycles
RELIST_AGE_DAYS=61                # Relist listings older than this many days
RELIST_CHECK_INTERVAL_MS=3600000  # How often to check for stale listings (1hr)
